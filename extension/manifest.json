{
  "manifest_version": 3,
  "name": "Geeksblock Ava Browser Extension",
  "short_name": "Ava Browser",
  "version": "0.1.0",
  "description": "Lets Ava drive a real, signed-in Chrome profile in the background — no focus theft, no remote-debugging prompt.",
  "minimum_chrome_version": "120",
  "author": "Geeksblock LLC",
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "scripting",
    "debugger",
    "storage",
    "alarms",
    "offscreen",
    "downloads"
  ],
  "host_permissions": ["<all_urls>"],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Geeksblock Ava Browser Extension",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
